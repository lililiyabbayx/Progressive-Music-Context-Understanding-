{
  "dataset": "FMA medium",
  "official_fma_split": true,
  "targets": {
    "genre": "16 class genre_top",
    "tags": "top 48 track tags selected from training only"
  },
  "text_source": [
    "track title",
    "album title",
    "artist name",
    "artist biography",
    "album information",
    "artist tags after leakage filtering",
    "album tags after leakage filtering"
  ],
  "track_tags_used_as_text_input": false,
  "sample_rate": 22050,
  "duration_seconds": 30.0,
  "segmentation": "Four beat groups with fixed three second fallback",
  "node_features": "MFCC chroma spectral contrast tonnetz and spectral statistics using segment mean and standard deviation",
  "node_feature_dimension": 100,
  "edge_types": [
    "temporal adjacency",
    "cosine similarity"
  ],
  "similarity_threshold": 0.5,
  "similarity_top_k": 3,
  "text_encoder": "distilbert-base-uncased",
  "bert_unfreeze_last_transformer_blocks": 2,
  "maximum_text_length": 128,
  "loss": "Genre cross entropy plus tag binary cross entropy with logits",
  "tag_loss_weight": 1.0,
  "models": [
    "bert_only",
    "gnn_only",
    "early_concat",
    "cross_attention"
  ],
  "batch_size": 12,
  "gradient_accumulation_steps": 2,
  "maximum_epochs": 12,
  "early_stopping_patience": 3,
  "bert_learning_rate": 2e-05,
  "new_layer_learning_rate": 0.0004,
  "weight_decay": 0.0001,
  "model_weights_saved": false,
  "large_raw_graph_cache_included_in_zip": false,
  "saved_graph_samples": 24,
  "fast_development_run": false,
  "seed": 42
}